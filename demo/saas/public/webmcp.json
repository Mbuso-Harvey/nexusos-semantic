{
  "version": "1.0.0",
  "tools": [
    {
      "name": "create_ticket",
      "description": "Create a new support ticket in the demo workspace.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title":    { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "body":     { "type": "string" }
        },
        "required": ["title", "severity", "body"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ticketId":  { "type": "string" },
          "createdAt": { "type": "string" }
        }
      },
      "binding": { "kind": "ax-node", "axId": "ax:btn-new-ticket" },
      "security": "EXECUTE"
    },
    {
      "name": "search_docs",
      "description": "Search the public docs index. Returns up to 5 matching titles + paths.",
      "inputSchema": {
        "type": "object",
        "properties": { "query": { "type": "string" } },
        "required": ["query"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "path":  { "type": "string" }
              }
            }
          }
        }
      },
      "binding": { "kind": "ax-node", "axId": "ax:search-input" },
      "security": "PROPOSE"
    },
    {
      "name": "delete_workspace",
      "description": "Permanently delete a workspace and all its data. IRREVERSIBLE.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": { "type": "string" },
          "confirmText": { "type": "string" }
        },
        "required": ["workspaceId", "confirmText"]
      },
      "outputSchema": { "type": "object", "properties": { "ok": { "type": "boolean" } } },
      "binding": { "kind": "ax-node", "axId": "ax:btn-delete-workspace" },
      "security": "CONFIRM",
      "confirmOnAct": true
    }
  ]
}
